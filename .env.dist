# Local settings for scripts and tests. Copy to .env (gitignored) and fill in what you need.
# Empty values are ignored. No comments after a value on the same line.

# Android TV device for scripts/install.sh: address for network ADB (ip:port)
TV_ADB=192.0.2.10:5555

# Toolchain, if not already set in your environment (JDK 17 and the Android SDK)
JAVA_HOME=
ANDROID_HOME=

# Optional install fallback through Home Assistant's Android TV integration,
# for when the TV has not authorised this computer's ADB key.
# HA_WWW_DIR is the host folder mounted as /config/www in the Home Assistant container.
HA_URL=
HA_TOKEN_FILE=
HA_ENTITY=
HA_WWW_DIR=

# Tests: Home live TV row for RealDataScreensTest when your snapshot does not record one
MASAL_TEST_HOME_GROUP=
MASAL_TEST_HOME_TITLE=

# Tests: text typed into Search in RealDataScreensTest (default "tv")
MASAL_TEST_SEARCH=

# Release signing for local release builds (scripts/create-release-key.sh fills these in)
MASAL_KEYSTORE_FILE=
MASAL_KEYSTORE_PASSWORD=
MASAL_KEY_ALIAS=
MASAL_KEY_PASSWORD=
