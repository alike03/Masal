<?xml version="1.0" encoding="utf-8"?>
<!-- Live player from Home: grows from the picture frame (top right, 62 % of a 16:9 screen) to full screen. -->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="380"
    android:fromXScale="0.62" android:toXScale="1.0"
    android:fromYScale="0.62" android:toYScale="1.0"
    android:pivotX="100%" android:pivotY="0%"
    android:interpolator="@android:interpolator/fast_out_slow_in" />
